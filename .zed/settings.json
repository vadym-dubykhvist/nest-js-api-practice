{
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "tsdk": "node_modules/typescript/lib"
        }
      }
    },
    "eslint": {
      "settings": {
        "workingDirectories": [{ "mode": "auto" }]
      }
    }
  },
  "languages": {
    "TypeScript": {
      "formatter": "prettier"
    }
  },
  "file_types": {
    "Helm": [
      "**/templates/*.yaml",
      "**/templates/*.tpl",
      "**/templates/**/*.yaml",
      "**/Chart.yaml",
      "**/values*.yaml"
    ]
  }
}
